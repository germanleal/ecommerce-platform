# Common platform configuration. Copy to a local, untracked env file.
PLATFORM_PROFILE=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/ecommerce
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=ecommerce_user
DATABASE_PASSWORD=change-me
KAFKA_URL=localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=platform
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/platform
TENANT_CONFIG=header-and-jwt
LOG_LEVEL=INFO
MANAGEMENT_ENDPOINTS=health,info,metrics,prometheus
SHUTDOWN_GRACE_PERIOD=30s
