KEYCLOAK_REALM=platform
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/platform
TENANT_CONFIG=header-and-jwt
LOG_LEVEL=INFO
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce_user
